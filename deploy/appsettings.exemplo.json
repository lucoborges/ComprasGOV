{
  // Modelo do arquivo de configuração do ComprasGOV. Em produção, copie para
  // C:\Services\ComprasGOV\config\appsettings.json (fora da pasta app\, que é trocada
  // a cada deploy) e preencha os valores internos. O arquivo real NÃO vai para o
  // repositório. Campos omitidos usam o padrão do código.
  //
  // Precedência: argumento de linha de comando > variável de ambiente COMPRASGOV_* >
  // este arquivo > padrão do código.
  //
  // A senha SMTP NUNCA fica aqui: só na variável de ambiente COMPRASGOV_SMTP_SENHA
  // (um campo "senha"/"password" neste arquivo é ignorado, com aviso no log).

  "Email": {
    "Destino": "destinatario@exemplo.com.br",
    "Remetente": "remetente@exemplo.com.br",
    "SmtpHost": "smtp.email-ssl.com.br",
    "SmtpPorta": 587,
    "LimiteAnexosMb": 20
  },

  "Pastas": {
    // Histórico (licitacoes_processadas.json) e cache UASG->CNPJ. Obrigatório
    // (ou COMPRASGOV_PASTA_BANCO, ou --historico). Pasta de rede: se estiver
    // inacessível o ciclo é adiado, nunca roda com histórico vazio.
    "Banco": "\\\\SERVIDOR\\Compartilhamento\\database",
    // Planilha e pasta de saída também podem vir de COMPRASGOV_PLANILHA e
    // COMPRASGOV_PASTA_SAIDA (que têm prioridade sobre o arquivo).
    "Planilha": "",
    "Saida": ""
  },

  "Execucao": {
    "IntervaloMinutos": 60,
    // Ciclo em andamento há mais que isto = travado (verificação de saúde).
    "CicloMaximoMinutos": 180
  },

  "BuscaGeral": {
    "Ufs": [ "ES" ],
    "Plataformas": {
      "3": "Compras.gov.br",
      "350": "PORTAL GOV SERVICOS DIGITAIS LTDA / PORTAL GOV"
    }
  },

  "Apis": {
    "Uasg": "https://dadosabertos.compras.gov.br/modulo-uasg/1_consultarUasg",
    "Propostas": "https://pncp.gov.br/api/consulta/v1/contratacoes/proposta",
    "Arquivos": "https://pncp.gov.br/api/pncp/v1/orgaos/{0}/compras/{1}/{2}/arquivos",
    "Busca": "https://pncp.gov.br/api/search/",
    "PortalPesquisa": "https://cnetmobile.estaleiro.serpro.gov.br/comprasnet-web/public/compras"
  },

  "Log": {
    // Em produção o iniciar.cmd define COMPRASGOV_PASTA_LOGS e COMPRASGOV_LOG_CONSOLE,
    // que têm prioridade sobre estes valores.
    "Pasta": "",
    "TamanhoMaximoMb": 10,
    "RetencaoDias": 30,
    "TamanhoTotalMaximoMb": 200,
    "Console": true
  },

  "Saude": {
    // Padrão: estado.json dentro da pasta de logs.
    "ArquivoEstado": ""
  }
}
